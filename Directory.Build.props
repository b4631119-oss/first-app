<Project>
  <PropertyGroup>
    <VersionPrefix>1.0.5</VersionPrefix>
    <Version Condition="'$(Version)' == ''">$(VersionPrefix)</Version>

    <AssemblyVersion Condition="'$(Version)' != ''">$([System.Version]::Parse('$(Version)').Major).$([System.Version]::Parse('$(Version)').Minor).$([System.Version]::Parse('$(Version)').Build).0</AssemblyVersion>
    <AssemblyVersion Condition="'$(AssemblyVersion)' == ''">$(VersionPrefix).0</AssemblyVersion>

    <FileVersion Condition="'$(Version)' != ''">$([System.Version]::Parse('$(Version)').Major).$([System.Version]::Parse('$(Version)').Minor).$([System.Version]::Parse('$(Version)').Build).0</FileVersion>
    <FileVersion Condition="'$(FileVersion)' == ''">$(VersionPrefix).0</FileVersion>

    <InformationalVersion Condition="'$(Version)' != ''">$(Version)</InformationalVersion>
    <InformationalVersion Condition="'$(InformationalVersion)' == ''">$(VersionPrefix)</InformationalVersion>

    <Authors>justnpm</Authors>
    <Product>My First App</Product>
    <Description>Avalonia Calculator Application</Description>
    <Copyright>Copyright © 2026</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/b4631119-oss/first-app</PackageProjectUrl>
    <RepositoryUrl>https://github.com/b4631119-oss/first-app</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>
</Project>