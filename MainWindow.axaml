<Window
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Class="MyFirstApp.MainWindow"
    Width="400"
    Height="600"
    MinWidth="320"
    MinHeight="500"
    Title="Calculator">

    <Window.Styles>

        <Style Selector="Button">
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Background" Value="#292929"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="14"/>
        </Style>

        <Style Selector="Button:pointerover">
            <Setter Property="Background" Value="#3A3A3A"/>
        </Style>

        <Style Selector="Button:pressed">
            <Setter Property="Background" Value="#505050"/>
        </Style>

        <Style Selector="Button.operator">
            <Setter Property="Background" Value="#FF9500"/>
        </Style>

        <Style Selector="Button.operator:pointerover">
            <Setter Property="Background" Value="#FFAA33"/>
        </Style>

        <Style Selector="Button.function">
            <Setter Property="Background" Value="#505050"/>
        </Style>

    </Window.Styles>

    <Border Background="#151515">

        <Viewbox
            Stretch="Uniform"
            HorizontalAlignment="Center"
            VerticalAlignment="Center">

            <Border
                Width="380"
                Height="570"
                Padding="16"
                Background="#151515">

                <Grid
                    RowDefinitions="100,*,*,*,*,*"
                    ColumnDefinitions="*,*,*,*"
                    RowSpacing="10"
                    ColumnSpacing="10">

                    <Border
                        Grid.Row="0"
                        Grid.ColumnSpan="4"
                        Background="#202020"
                        CornerRadius="18"
                        Padding="20">

                        <Grid>

                            <TextBlock
                                x:Name="VersionText"
                                Text="v1.0.0"
                                FontSize="12"
                                Foreground="#808080"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Top"/>

                            <TextBlock
                                x:Name="Result"
                                Text="0"
                                FontSize="42"
                                FontWeight="SemiBold"
                                Foreground="White"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                TextTrimming="CharacterEllipsis"/>

                        </Grid>

                    </Border>

                    <Button
                        Grid.Row="1"
                        Grid.Column="0"
                        Content="C"
                        Tag="C"
                        Classes="function"/>

                    <Button
                        Grid.Row="1"
                        Grid.Column="1"
                        Content="⌫"
                        Tag="BACK"
                        Classes="function"/>

                    <Button
                        Grid.Row="1"
                        Grid.Column="2"
                        Content="%"
                        Tag="%"
                        Classes="function"/>

                    <Button
                        Grid.Row="1"
                        Grid.Column="3"
                        Content="÷"
                        Tag="/"
                        Classes="operator"/>

                    <Button
                        Grid.Row="2"
                        Grid.Column="0"
                        Content="7"
                        Tag="7"/>

                    <Button
                        Grid.Row="2"
                        Grid.Column="1"
                        Content="8"
                        Tag="8"/>

                    <Button
                        Grid.Row="2"
                        Grid.Column="2"
                        Content="9"
                        Tag="9"/>

                    <Button
                        Grid.Row="2"
                        Grid.Column="3"
                        Content="×"
                        Tag="*"
                        Classes="operator"/>

                    <Button
                        Grid.Row="3"
                        Grid.Column="0"
                        Content="4"
                        Tag="4"/>

                    <Button
                        Grid.Row="3"
                        Grid.Column="1"
                        Content="5"
                        Tag="5"/>

                    <Button
                        Grid.Row="3"
                        Grid.Column="2"
                        Content="6"
                        Tag="6"/>

                    <Button
                        Grid.Row="3"
                        Grid.Column="3"
                        Content="−"
                        Tag="-"
                        Classes="operator"/>

                    <Button
                        Grid.Row="4"
                        Grid.Column="0"
                        Content="1"
                        Tag="1"/>

                    <Button
                        Grid.Row="4"
                        Grid.Column="1"
                        Content="2"
                        Tag="2"/>

                    <Button
                        Grid.Row="4"
                        Grid.Column="2"
                        Content="3"
                        Tag="3"/>

                    <Button
                        Grid.Row="4"
                        Grid.Column="3"
                        Content="+"
                        Tag="+"
                        Classes="operator"/>

                    <Button
                        Grid.Row="5"
                        Grid.Column="0"
                        Content="±"
                        Tag="PLUSMINUS"
                        Classes="function"/>

                    <Button
                        Grid.Row="5"
                        Grid.Column="1"
                        Content="0"
                        Tag="0"/>

                    <Button
                        Grid.Row="5"
                        Grid.Column="2"
                        Content="."
                        Tag="."/>

                    <Button
                        Grid.Row="5"
                        Grid.Column="3"
                        Content="="
                        Tag="="
                        Classes="operator"/>

                </Grid>

            </Border>

        </Viewbox>

    </Border>

</Window>